# Copy this file to ".env" (same folder) and fill in your real API key below.
# Never share the real .env file or upload it anywhere public.

ANTHROPIC_API_KEY=your-api-key-goes-here

# You normally won't need to change this, but it's here so the model name
# lives in one place instead of being hardcoded all over the code.
CLAUDE_MODEL=claude-sonnet-5
